{
  "name": "kupanga-video",
  "private": true,
  "description": "Vidéo de démo Kupanga (Remotion) : vraies captures de l'app animées, voix off, musique",
  "scripts": {
    "voice": "python -I scripts/voice.py",
    "shots": "python -I scripts/importer-captures.py",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Kupanga out/kupanga-demo-4k.mp4 --scale=2 --crf=16",
    "render:draft": "remotion render src/index.ts Kupanga out/kupanga-draft.mp4 --scale=0.5",
    "still": "remotion still src/index.ts Kupanga out/still.png --frame=300",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
