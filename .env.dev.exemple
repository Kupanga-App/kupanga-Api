# ─────────────────────────────────────────────────────────────────────────────
# Kupanga — variables de DÉVELOPPEMENT (modèle)
#
#   cp .env.dev.exemple .env.dev     puis remplir les valeurs marquées « À CHANGER »
#
# .env.dev est ignoré par git : n'y mettez jamais un secret de production, et ne committez jamais .env.dev.
# Le stockage S3 (RustFS) et les e-mails (Mailpit) n'ont besoin d'aucune variable en dev :
# docker-compose-dev.yml les configure (cf. GUIDE-DEMARRAGE.md).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Base PostgreSQL + PostGIS (conteneur « db ») ──────────────────────────────
# Lus par le conteneur PostgreSQL à sa première création, et par l'API.
POSTGRES_DB=kupanga_dev
POSTGRES_USER=kupanga
POSTGRES_PASSWORD=devpassword
# Adresse vue depuis le conteneur de l'API (nom de service « db », port interne 5432).
# API lancée depuis l'IDE : jdbc:postgresql://localhost:5433/kupanga_dev (à mettre dans la configuration de lancement)
DB_URL=jdbc:postgresql://db:5432/kupanga_dev

# ─── Jetons de connexion (JWT) ─────────────────────────────────────────────────
# À CHANGER : clé aléatoire en base64, au moins 32 octets. Générer avec :
#   openssl rand -base64 48
#   (PowerShell) [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET_KEY=A_CHANGER_cle_base64_de_48_octets_au_moins

# ─── Back-office (/backoffice) ─────────────────────────────────────────────────
# Compte unique de l'administrateur (aucun compte admin en base).
ADMIN_EMAIL=admin@kupanga.test
ADMIN_PASSWORD=A_CHANGER_mot_de_passe_admin

# ─── Connexion Google (facultatif) ─────────────────────────────────────────────
# Identifiant client OAuth « Application Web » (Google Cloud Console), origine autorisée http://localhost:4200.
# Sans lui, tout fonctionne sauf le bouton « Se connecter avec Google ».
GOOGLE_CLIENT_ID=

# ─── E-mails réels en dev (facultatif) ─────────────────────────────────────────
# Par défaut, docker-compose-dev.yml envoie tout vers Mailpit (http://localhost:8025) : rien ne part vraiment.
# Pour un vrai envoi : retirer les lignes SMTP_* du service « kupanga » dans docker-compose-dev.yml, puis :
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# EMAIL_EXPEDITEUR=adresse-validee-chez-le-fournisseur@exemple.fr
